{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Gyerek_jatek (Mega)",
      "type": "shell",
      "command": "platformio",
      "windows": {
        "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe"
      },
      "args": ["run", "-e", "megaatmega2560"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test Gyerek_jatek (no hardware)",
      "type": "shell",
      "command": "python",
      "args": ["tools/run_tests.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": ["$gcc"]
    }
  ]
}